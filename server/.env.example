# Veriff Station > Integrations 에서 확인
VERIFF_API_KEY=your-api-key-uuid
# 웹훅 HMAC 서명 검증용 shared secret (Station > Integrations)
VERIFF_SHARED_SECRET=your-shared-secret

# 선택 사항: 셀피 재인증(Biometric Authentication)용.
# Veriff에 문의해 별도 integration을 활성화한 뒤 그 integration의 API key를 넣는다.
# 미설정 시 POST /authentication은 501을 반환한다.
# VERIFF_AUTH_API_KEY=your-auth-api-key-uuid

# 선택 사항
PORT=3000
VERIFF_BASE_URL=https://stationapi.veriff.com
